{
  "name": "Deep Tab",
  "version": "1.0.1",
  "description": "一款用于搜索、应用快捷入口、壁纸和个性化设置的新标签页插件",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://webapi.aizerospace.com/*",
    "https://api.bing.com/*",
    "https://api-hot.imsyy.top/*",
    "https://dailyhot.aizhi.ink/*",
    "https://api.zxki.cn/*",
    "https://dailyhotapi.3yu3.top/*",
    "https://api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://icons.duckduckgo.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "extension/background/index.js"
  },
  "action": {
    "default_title": "Deep Tab",
    "default_icon": "src/assets/images/favicon-300.png",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "src/assets/images/favicon-300.png",
    "48": "src/assets/images/favicon-300.png",
    "128": "src/assets/images/favicon-300.png"
  }
}
